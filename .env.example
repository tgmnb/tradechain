POSTGRES_DB=tradechain
POSTGRES_USER=tradechain
POSTGRES_PASSWORD=tradechain
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://tradechain:tradechain@postgres:5432/tradechain

REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tradechain-archives
MINIO_SECURE=false

INTERNAL_SERVICE_API_KEY=internal-dev-key
API_SERVICE_API_KEY=external-dev-key

INGESTION_SERVICE_URL=http://ingestion-service:8001
AGENT_CORE_SERVICE_URL=http://agent-core:8002
ARCHIVE_SERVICE_URL=http://archive-service:8003
EVALUATION_SERVICE_URL=http://evaluation-service:8004

# Online provider default. For offline local work, override to heuristic.
LLM_PROVIDER=minimax
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_API_KEY=
LLM_MODEL=MiniMax-M2.5
LLM_TIMEOUT_SECONDS=60
LLM_PROXY_URL=

DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_PROXY_URL=http://host.docker.internal:7890
DISCORD_PROXY_USERNAME=
DISCORD_PROXY_PASSWORD=
DISCORD_BOT_API_URL=http://api-service:8000
DISCORD_BOT_API_KEY=external-dev-key
