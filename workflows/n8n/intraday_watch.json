            { "name": "X-Chain-Type", "value": "intraday_watch" },
            { "name": "X-Actor", "value": "n8n" }
          ]
        }
      },
      "id": "call_placeholder",
      "name": "Call Placeholder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [540, 260]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [[{ "node": "Call Placeholder", "type": "main", "index": 0 }]]
    }
